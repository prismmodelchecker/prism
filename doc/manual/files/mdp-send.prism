// Module P1 "sends" a value (1 or 2) to P2, using a different action for each

mdp

module P1

	s1 : [0..2] init 0;

	[a] s1=0 -> 0.9:(s1'=1) + 0.1:(s1'=2);
	[c1] s1=1 -> (s1'=0);
	[c2] s1=2 -> (s1'=0);

endmodule

module P2

	s2 : [0..2] init 0;

	[c1] s2=0 -> (s2'=1);
	[c2] s2=0 -> (s2'=2);
	[d] s2>0 -> (s2'=0);

endmodule