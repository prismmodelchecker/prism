// A simple IMDP: a robot chooses between a fast route with
// an uncertain chance of success and a slower but reliable one

mdp

module M

    s : [0..3]; // 0=start, 1=slow route, 2=goal, 3=crash

    [fast] s=0 -> [0.7,0.9]:(s'=2) + [0.1,0.3]:(s'=3);
    [slow] s=0 -> (s'=1);
    [slow] s=1 -> 0.8:(s'=2) + 0.2:(s'=3);
    [done] s>=2 -> true;

endmodule

label "goal" = s=2;
