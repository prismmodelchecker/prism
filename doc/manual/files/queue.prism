// An N-place queue and a server

ctmc

const int N = 2;
const double lambda = 1/10;
const double mu = 1/2;
const double gamma = 1/3;

module queue
     q : [0..N];

     [arrive] q<N -> lambda:(q'=q+1);
     [serve] q>0 -> mu:(q'=q-1);
endmodule

module server
     s : [0..1];

     [serve] s=0 -> 1:(s'=1);
     [process] s=1 -> gamma:(s'=0);
endmodule