// DTMC with a negative state reward.
// Regression test: for instantaneous-reward properties (R=?[I=k]), the reward
// at a single time step is reported directly rather than being cumulated, so
// negative rewards are legitimate there and must not be rejected - unlike for
// cumulative reward properties (e.g. R=?[C<=k]), where negative rewards are
// disallowed since they would make an unbounded sum ill-defined.

dtmc

module M
	s : [0..1] init 0;
	[] s=0 -> 1: (s'=1);
	[] s=1 -> 1: true;
endmodule

rewards
	s=0 : -5;
	s=1 : 3;
endrewards
