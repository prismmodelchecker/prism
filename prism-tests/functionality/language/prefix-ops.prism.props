// Prefix operators (! and X/F/G) as the operand of a tighter binary operator.
// The scope of the prefix operator extends as far to the right as its
// own precedence allows, e.g. "a=!b&c" is "(a=(!b))&c". For temporal
// operators, ambiguous cases such as "a&F b&c" and "F a&G b" are errors.

// RESULT: true
true = !false;

// RESULT: false
true = !false & false;

// RESULT: true
true = !(false & false);

// RESULT: 0.5
P=? [ s=0 & X s=1 ];

// RESULT: 0.5
P=? [ !X s=1 ];

// RESULT: 1/6
P=? [ s=0 & F s=4 ];

// RESULT: 5/6
P=? [ !F s=4 ];

// RESULT: 1/6
P=? [ s=1 | F s=4 ];

// "s=0 & G F s=4" is "s=0 & (G (F s=4))"

// RESULT: 1/6
P=? [ s=0 & G F s=4 ];

// "F a & G b" is not allowed (ambiguous), but these are

// RESULT: 1/6
P=? [ F s=4 & (G s=4) ];

// RESULT: 1/6
P=? [ F (s=4 & (G s=4)) ];

// RESULT: 0
P=? [ (F s=4) & (G s=4) ];

// Similarly for "a & F b U c"

// RESULT: 0
P=? [ (s=0 & (F s=1)) U s=2 ];

// RESULT: 1/6
P=? [ s=0 & ((F s=1) U s=2) ];
