// Test of associativity of restricted parallel composition (|[...]|):
// "M1 |[x]| M2 |[y]| M3" means "(M1 |[x]| M2) |[y]| M3", not "M1 |[x]| (M2 |[y]| M3)"

mdp

module M1
	a : [0..1];
	[y] a=0 -> (a'=1);
endmodule

module M2
	b : [0..1];
	[x] b=0 -> (b'=1);
endmodule

module M3
	c : [0..1];
	[y] c=0 -> (c'=1);
endmodule

system
	M1 |[x]| M2 |[y]| M3
endsystem
