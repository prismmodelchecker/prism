// Regression tests for -exportstrat induced-model export for step-bounded
// properties, whose strategies use memory (the number of steps taken).
// The optimal strategies for the properties used are unique.

mdp

module m

	s:[0..3];

	[a] s=0 -> (s'=1);
	[b] s=0 -> 0.5:(s'=3) + 0.5:(s'=2);
	[a] s=1 -> (s'=3);
	[b] s=1 -> (s'=2);
	[] s=2 -> true;
	[] s=3 -> (s'=2);

endmodule

label "goal" = s=3;
