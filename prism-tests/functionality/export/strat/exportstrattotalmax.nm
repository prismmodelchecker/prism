// Regression test for strategy generation for maximum total rewards (R[C])
// in states with infinite values. The strategy needs to reach the end component
// {s=1,s=3} and then keep visiting s=1 (which has positive reward) in it.
// Previously, no choices were generated for these states. The optimal strategy
// is unique, and the first choice in each state is not optimal.

mdp

module m

	s:[0..3];

	[b] s=0 -> (s'=2);
	[a] s=0 -> (s'=1);
	[d] s=1 -> (s'=2);
	[c] s=1 -> (s'=3);
	[f] s=3 -> (s'=3);
	[e] s=3 -> (s'=1);
	[] s=2 -> true;

endmodule

rewards
	s=1 : 1;
endrewards
