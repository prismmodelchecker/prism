// Tests that Rmin=?[F target] correctly handles zero-reward end components on
// the path to the target, on all engines. Naive value iteration for Rmin can
// converge to a spurious "stuck at zero reward forever" fixed point whenever
// a zero-reward EC sits on the path: looping forever trivially satisfies the
// Bellman equation V = min(V, escape_cost) at V=0, even though looping never
// actually reaches the target. The explicit engine avoids this by collapsing
// each zero-reward EC into a single representative state before solving
// (ZeroRewardECQuotient); the symbolic engines (-m/-s) previously only
// detected and *warned* about this ("your minimum rewards may be too low"),
// without actually fixing the computation, silently returning 0 instead of
// the true escape cost.
//
// Three independent scenarios, reachable via [goto]-style actions from the
// initial state so each can be queried in isolation via filter(state, ...):
//  - s=0: a single-state zero-reward self-loop with an escape action
//    (reward 5). True Rmin = 5 (the escape cost); the bug would give 0.
//  - s=10,11: a 2-state zero-reward end component (0<->1 cycle) with an
//    escape action from s=11 (reward 10). Tests that a *multi-state* EC is
//    correctly collapsed, not just a literal self-loop. True Rmin = 10.
//  - s=20,21,22: a non-trivial EC {21,22} feeding into a downstream state
//    (s=20) that merely *depends* on the (fixed) EC value, without itself
//    being part of any EC. Tests that the fix correctly propagates through
//    states outside the EC. True Rmin from s=20 = 7 (solved below).

mdp

module M

	s : [0..99] init 30;

	// entry points, reachable from the (unused) initial state 30
	[gotoA] s=30 -> (s'=0);
	[gotoB] s=30 -> (s'=10);
	[gotoC] s=30 -> (s'=20);

	// Scenario A: single-state self-loop trap
	[loopA] s=0 -> (s'=0);
	[exitA] s=0 -> (s'=99);

	// Scenario B: 2-state mutual-loop trap
	[ab] s=10 -> (s'=11);
	[ba] s=11 -> (s'=10);
	[exitB] s=11 -> (s'=99);

	// Scenario C: EC {21,22} feeding a downstream (non-EC) state s=20
	[step1] s=20 -> (s'=21);
	[step2] s=21 -> 0.5:(s'=20) + 0.5:(s'=22);
	[stay]  s=22 -> (s'=22);
	[exitC] s=22 -> (s'=99);

	[] s=99 -> (s'=99);

endmodule

rewards
	[exitA] true : 5;
	[exitB] true : 10;
	[exitC] true : 7;
endrewards
