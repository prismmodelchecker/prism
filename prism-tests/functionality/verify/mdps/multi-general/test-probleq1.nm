// Simple MDP for testing multi-objective queries involving upper-bounded probability
// (P<=) and three-probability-objective achievability.
// State 0 offers a non-deterministic choice between actions a, b, c;
// each transitions to a distinct intermediate state (1, 2, 3) from which
// the only move leads to the absorbing sink state 4.
// The model is essentially deterministic after the initial choice, making
// expected-value computations straightforward to verify by hand.
// With a randomised strategy using probabilities p_a, p_b, p_c (sum = 1) at state 0:
//   P[F x=1] = p_a,  P[F x=2] = p_b,  P[F x=3] = p_c

mdp

module M

x : [0..4] init 0;

[a] x=0 -> (x'=1);
[b] x=0 -> (x'=2);
[c] x=0 -> (x'=3);
[d] x=1 -> (x'=4);
[e] x=2 -> (x'=4);
[f] x=3 -> (x'=4);
[] x=4 -> (x'=4);

endmodule
