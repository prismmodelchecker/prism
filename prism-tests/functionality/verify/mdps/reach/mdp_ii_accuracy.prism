// Checks that the accuracy of interval iteration for MDP probabilities is
// kept on all engines. States 0 and 3 form an end component, so interval
// iteration solves a quotient MDP and projects the result back.
// With a loose epsilon (-e 1e-2, see .args), the guaranteed error bound is
// much larger than the default testing tolerance, so the test only passes
// if that bound is attached to the final result.
// Pmax=?[F s=1]: p = 0.5 + 0.5*0.9*p, so p = 10/11.

mdp

module M

	s : [0..4];

	[a] s=0 -> 0.5:(s'=1) + 0.5:(s'=2);
	[b] s=0 -> (s'=3);
	[c] s=3 -> (s'=0);
	[]  s=2 -> 0.9:(s'=0) + 0.1:(s'=4);
	[]  s=1 -> true;
	[]  s=4 -> true;

endmodule
