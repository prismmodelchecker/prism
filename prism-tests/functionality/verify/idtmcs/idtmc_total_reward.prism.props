// RESULT: Infinity
R{"r"}min=?[C]

// RESULT: Infinity
R{"r"}max=?[C]

// Same model, but with a discount factor (discount=0.9, via the C
// operator's {discount=...} option). Discounting turns the previously
// Infinite value into a finite one: V(s=2) = 5/(1-0.9) = 50, and
// V(s=0) = 0.9 * (1-p) * 50 for p = P(move to s=1) in [0.4,0.6], so min
// uncertainty (maximising p) gives 0.9*0.4*50 = 18, and max uncertainty
// (minimising p) gives 0.9*0.6*50 = 27.

// RESULT: [17.999,18.001]
R{"r"}min=?[C{discount=0.9}]

// RESULT: [26.999,27.001]
R{"r"}max=?[C{discount=0.9}]
